{
  "manifest_version": 3,
  "name": "AGY Chrome Bridge",
  "version": "0.6.0",
  "description": "Share chosen Chrome tabs with the Antigravity CLI and IDE.",
  "key": "",
  "permissions": ["alarms", "debugger", "storage", "tabs"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {"service_worker": "background.js"},
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "action": {"default_popup": "popup.html", "default_title": "AGY Chrome Bridge", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}
}
