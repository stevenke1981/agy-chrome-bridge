{
  "manifest_version": 3,
  "name": "AGY Chrome Bridge",
  "version": "0.3.1",
  "description": "Share chosen Chrome tabs with the Antigravity CLI and IDE.",
  "key": "",
  "permissions": ["debugger", "storage", "tabs"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "AGY Chrome Bridge"}
}
